{
    "name": "erpsaas/hr",
    "description": "HR plugin for ERPSAAS — employees, salary structures, salary parts, and payroll entries.",
    "authors": [
        {
            "name": "NR-Anna-Rosenwasser",
            "homepage": "https://github.com/NR-Anna-Rosenwasser/erpsaas",
            "role": "Original Author"
        },
        {
            "name": "ERPSAAS",
            "email": "support@erpsaas.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Erpsaas\\Hr\\HrServiceProvider"
            ],
            "aliases": {}
        }
    },
    "autoload": {
        "psr-4": {
            "Erpsaas\\Hr\\": "src/",
            "Erpsaas\\Hr\\Database\\Factories\\": "database/factories/",
            "Erpsaas\\Hr\\Database\\Seeders\\": "database/seeders/",
            "Database\\Factories\\Erpsaas\\Core\\Models\\": "database/factories/Aliases/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Erpsaas\\Hr\\Tests\\": "tests/"
        }
    }
}
